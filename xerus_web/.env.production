# Xerus Web App - Production Environment Configuration for AWS Deployment

# Application URLs
NEXT_PUBLIC_API_URL=https://api.xerus.ai/api/v1
NEXT_PUBLIC_WEB_URL=https://app.xerus.ai

# Backend API URL (for server-side requests)
API_URL=https://api.xerus.ai/api/v1

# Firebase Configuration (Production)
# Firebase web config is public by design (embedded in client bundle).
# Access control is enforced by Firebase Security Rules + authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDqHxy5EIWjxMeb7Al26se6W1_Ohgs6BaM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xerus-d067d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xerus-d067d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xerus-d067d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=211398004933
NEXT_PUBLIC_FIREBASE_APP_ID=1:211398004933:web:56f0850a89ccfbbd0e20ac
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_DEBUG_MODE=false

# AWS Deployment Settings
NODE_ENV=production
PORT=3000

# Security Headers
NEXT_PUBLIC_ALLOWED_ORIGINS=https://app.xerus.app,https://xerus.app

# Pipedream Connect Configuration
NEXT_PUBLIC_PIPEDREAM_ENVIRONMENT=production
