# E2E Test Configuration
# Copy to .env and fill in values from your xerus_backend/.env

E2E_BASE_URL=http://localhost:3005
E2E_API_URL=http://localhost:5001/api/v1

# Test user (must exist in Firebase + Neon DB)
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_UID=

# Firebase (from xerus_backend/.env)
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Database (from xerus_backend/.env)
DATABASE_URL=
