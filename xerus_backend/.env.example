# Server Configuration
NODE_ENV=development
PORT=5001
API_BASE_URL=http://localhost:5001/api/v1

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Firebase Authentication
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-credentials.json
JWT_SECRET=your-jwt-secret

# Daytona Sandbox (Agent Execution Runtime)
DAYTONA_API_KEY=daytona_xxx
DAYTONA_API_URL=http://localhost:3000/api
# Daytona base image for sandboxes (REQUIRED):
#   xerus-sandbox   — custom image with pre-installed deps (recommended)
#   daytona-medium  — generic image, npm install on first run (slower, no custom build needed)
DAYTONA_SNAPSHOT=xerus-sandbox
XERUS_WORKSPACE_ROOT=/home/daytona

# External Services - Pipedream Connect (Tools)
PIPEDREAM_CLIENT_ID=your_pipedream_client_id
PIPEDREAM_CLIENT_SECRET=your_pipedream_client_secret
PIPEDREAM_PROJECT_ID=your_pipedream_project_id
PIPEDREAM_PROJECT_ENVIRONMENT=development

# AI Providers
OPENROUTER_API_KEY=sk-or-xxx
OPENAI_API_KEY=sk-xxx

# Claude Agent SDK (via OpenRouter)
# See: https://openrouter.ai/docs/guides/claude-code-integration
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-xxx
ANTHROPIC_API_KEY=

# API Key Encryption (32 characters for AES-256)
API_KEY_ENCRYPTION_KEY=your-32-character-encryption-key

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/xerus-backend.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# S3 Storage (KB backup only - workspace on Daytona volumes)
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=ap-southeast-1
S3_ENDPOINT_URL=
S3_PRESIGNED_URL_EXPIRY=3600

# MinIO endpoint override for host-side scripts (npm run snapshot:create).
# The Daytona API returns http://minio:9000 (Docker-internal) for S3 push access.
# This rewrites that URL to a host-reachable address. Required for snapshot builds.
MINIO_ENDPOINT_OVERRIDE=http://localhost:9000

# Background Jobs
ENABLE_CRON_JOBS=true

# Execution Domain Limits
MAX_EXECUTION_TIME_MS=300000
MAX_TOKENS_PER_EXECUTION=200000
MAX_TOOL_CALLS_PER_EXECUTION=50
MAX_CONCURRENT_HEARTBEATS=3
HEARTBEAT_SNAPSHOT_LEAD_TIME_MS=300000

# CORS
ALLOWED_ORIGINS=http://localhost:3002

# Webhooks
WEBHOOK_BASE_URL=http://localhost:3001/api/v1/webhooks
PIPEDREAM_WEBHOOK_SECRET=

# API
XERUS_API_BASE_URL=http://localhost:3001

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pipedream MCP
PIPEDREAM_MCP_URL=https://mcp.pipedream.com

# Database Pool
DB_POOL_MAX=20
DATABASE_POOL_MIN=2

# S3 Backup
BACKUP_CRON=0 3 * * *
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Legacy Services (deprecated - will be removed)
# Mnemosyne RAG (replaced by file-based KB in workspace)
MNEMOSYNE_API_URL=http://localhost:8000
MNEMOSYNE_API_KEY=mn_xxx
# Connectors (replaced by Pipedream Connect)
CONNECTORS_API_URL=http://localhost:3000
CONNECTORS_PLATFORM_KEY=xxx
